{
    "name": "pku-art",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build:local": "PKU_ART_LOCAL=1 vite build",
        "build:fork": "PKU_ART_FORK=1 PKU_ART_VERSION=2.6.26.1 vite build && cp dist/pku-art.user.js release/PKU-Art.user.js",
        "build:check": "vite build",
        "dev": "vite",
        "build": "uv run update-cdn.py build",
        "preview": "vite preview",
        "release": "uv run update-cdn.py update"
    },
    "devDependencies": {
        "dotenv": "^16.4.5",
        "unplugin-auto-import": "^0.17.5",
        "vite": "^6.2.1",
        "vite-plugin-mkcert": "^1.17.6",
        "vite-plugin-monkey": "^7.1.8"
    },
    "dependencies": {
        "monkey": "^0.9.0"
    }
}
